<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regresion automatizada OrangeHRM" parallel="none">

    <test name="Regresion Chrome" preserve-order="true">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="automated"/>
            </run>
        </groups>
        <classes>
            <class name="page_tests.LoginTest"/>
            <class name="page_tests.EmployeeTest"/>
        </classes>
    </test>

    <test name="Regresion Firefox" preserve-order="true">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run>
                <include name="automated"/>
            </run>
        </groups>
        <classes>
            <class name="page_tests.LoginTest"/>
            <class name="page_tests.EmployeeTest"/>
        </classes>
    </test>

    <test name="Regresion Edge" preserve-order="true">
        <parameter name="browser" value="edge"/>
        <groups>
            <run>
                <include name="automated"/>
            </run>
        </groups>
        <classes>
            <class name="page_tests.LoginTest"/>
            <class name="page_tests.EmployeeTest"/>
        </classes>
    </test>

</suite>
